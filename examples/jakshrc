# Script khởi động JakShell — đặt tại ~/.jakshrc
# Được chạy SAU khi đã đọc ~/.jakshrc.toml.
# Mỗi dòng là một lệnh shell hợp lệ (alias, export, source, ...).

# Ví dụ: thêm thư mục bin cá nhân vào PATH
export PATH=$HOME/.local/bin:$PATH

# Ví dụ alias ngắn ngoài file TOML
# Lưu ý: alias có giá trị nhiều từ phải dùng nháy kép — nếu không, từ thứ 2
# sẽ bị xem là arg riêng và alias builtin sẽ in `alias <tên>='...'` ra stdout.
alias c=clear
alias ..="cd .."
